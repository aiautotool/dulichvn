EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Sign-In uses Firebase Auth on iOS/Android.
# iOS reads ./GoogleService-Info.plist; Android reads ./google-services.json.
# This web client ID is passed to native Google Sign-In to mint Firebase credentials.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=959396812028-5uedsvgcclv8ngjs97enll5tlmld45oa.apps.googleusercontent.com

# Optional backend endpoint. The bundled Cloudflare Worker exposes this after deploy.
EXPO_PUBLIC_VINAGO_API_BASE_URL=https://vinago.aiautotool.com
EXPO_PUBLIC_ITINERARY_EMAIL_ENDPOINT=/api/itinerary-email
EXPO_PUBLIC_AI_VISION_ENDPOINT=https://vinago.aiautotool.com/api/ai/vision

# LiveKit video calls. Keep API credentials server-side in Wrangler secrets.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
# FIREBASE_PROJECT_ID=vinago-e7476

# Worker-only secret — set with `npx wrangler secret put GEMINI_API_KEY`.
# Never prefix this with EXPO_PUBLIC_ or commit the real key.
# GEMINI_API_KEY=your-google-ai-studio-key

# Optional. Keep unset/0 in production so app uses generated local translation packs only.
EXPO_PUBLIC_ENABLE_RUNTIME_TRANSLATION_FALLBACK=0

# Optional local deploy file: copy these to .env.cloudflare.local.
# Never commit real Cloudflare credentials.
CLOUDFLARE_EMAIL=info@aiautotool.com
CLOUDFLARE_API_KEY=your-global-api-key
