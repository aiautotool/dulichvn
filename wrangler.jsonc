{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinago-plus",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/privacy-policy",
      "/privacy-policy/"
    ]
  },
  "vars": {
    "ITINERARY_EMAIL_FROM": "Vinago+ <itinerary@aiautotool.com>",
    "FIREBASE_PROJECT_ID": "vinago-e7476"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QR_AUTH_STORE",
        "class_name": "QrAuthDurableObject"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "vinago-auth",
      "database_id": "f69522a7-67c3-4075-993a-55cb5dcfdb9e"
    }
  ],
  "migrations": [
    {
      "tag": "v1_qr_auth_store",
      "new_sqlite_classes": [
        "QrAuthDurableObject"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "vinago.aiautotool.com",
      "custom_domain": true
    }
  ]
}
